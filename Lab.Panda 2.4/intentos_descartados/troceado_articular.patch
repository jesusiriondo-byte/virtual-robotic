+    def _publish_sin_dejar_atras(self, th, prev_th, label):
+        """Publica una pose troceandola si el salto ARTICULAR respecto a la
+        anterior es mayor de lo que el motor alcanza entre dos comandos (ver
+        PASO_SEGURIDAD).
+
+        Ojo, aqui esta la trampa que costo un intento fallido: no vale mirar
+        cuanto gira el TCP. Medido el 2026-09-10, una rampa que mueve el yaw
+        90 grados hace girar joint7 mas del DOBLE -- la IK reparte el giro
+        entre varias articulaciones y ninguna sigue al TCP 1:1. Por eso el
+        limite se aplica sobre el delta articular ya resuelto, que es lo que
+        de verdad recibe el motor.
+
+        Trocear no cambia la trayectoria: los extremos son los mismos y los
+        puntos que se anaden caen en la recta entre ellos (mismo principio
+        que park_at_home). Solo la recorre mas fina, dando tiempo al brazo
+        real a llegar -- self.real_theta guarda lo COMANDADO, asi que si el
+        motor se queda atras nadie se entera y el paso siguiente sale como
+        un tiron ("hace como un tick antes de coger")."""
+        if prev_th is None:
+            self._publish(th)
+            return
+        paso_max = JOINT_VELOCITY_RAD_S * self.sleep * PASO_SEGURIDAD
+        salto = float(np.max(np.abs(np.asarray(th) - np.asarray(prev_th))))
+        if paso_max <= 0.0 or salto <= paso_max:
+            self._publish(th)
+            return
+        trozos = int(np.ceil(salto / paso_max))
+        self.get_logger().info(
+            f'[suavizado] {label}: una articulacion pedia {np.degrees(salto):.1f} grados '
+            f'de golpe, mas de los {np.degrees(paso_max):.1f} que da el motor -- '
+            f'lo parto en {trozos} para que el brazo no se quede atras.')
+        prev = np.asarray(prev_th, dtype=float)
+        objetivo = np.asarray(th, dtype=float)
+        for k in range(1, trozos + 1):
+            self._publish(prev + (objetivo - prev) * (k / trozos))
+
